{"publish":{"publish_pages_app":true,"publish_static_site":false,"publish_sha":"","publish_iso_date":"","include_slug_in_base":true},"users":[{"login_name":"XiaohuiLiu8407","avatar_url":"https://avatars.githubusercontent.com/u/346647384?v=4","admin":true}],"project":{"github_org":"XiaohuiLiu8407","is_private":false,"title":"Who Has Seen the Sounds? An Annotated Ethnography of Tibetan Women’s Sonic Knowledge","description":"This AVAnnotate project examines how Tibetan women develop and narrate sonic and ecological knowledge through everyday domestic and pastoral labor in Nasuoni Village, Yushu Tibetan Autonomous Prefecture, Qinghai, China. Conceived as an essay-equivalent outcome, it brings Steven Feld’s acoustemology into conversation with ecofeminism. Drawing on my ethnographic documentary, *Who Has Seen the Sounds?*, the project explores how Tibetan women’s sonic experiences and knowledge give them authority in understanding their multispecies environment, yet this authority is not matched by the social status and recognition they receive. Through AVAnnotate’s time-based annotations, the project connects audiovisual moments with translations, ethnographic context, and theoretical analysis. It examines how digital annotation can extend ethnographic filmmaking by developing a scholarly argument across film excerpts while keeping women’s interpretations and the contexts of their listening central.","language":"en","slug":"tibetan-women-sonic-knowledge","creator":"XiaohuiLiu8407","authors":"","media_player":"avannotate","auto_populate_home_page":true,"additional_users":[],"tags":{"tagGroups":[{"category":"_uncategorized_","color":"#A3A3A3"},{"color":"#ADFFD9","category":"Spirituality"},{"color":"#ADFEFF","category":"Sound and Listening"},{"color":"#99E6FF","category":"Multispecies Relations"},{"color":"#88C9F2","category":"Knowledge and Recognition"},{"color":"#99AFF2","category":"Pastoral Life and Environment"},{"color":"#B3B3E6","category":"Kinship and Care"},{"colo